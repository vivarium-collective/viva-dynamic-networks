itter", "config": {"emit": {"nodes": "map[dynamic_node]", "edges": "map[dynamic_edge]", "time": "float"}}, "inputs": {"nodes": ["nodes"], "edges": ["edges"], "time": ["global_time"]}, "doc": "Store historical states in memory.\n\n``subsample`` records only every Nth composite tick (default 1 =\nevery tick). Use this for long runs or composites with heavy\nstate (large fields, many agents) to keep RAM bounded \u2014 the\nsaved time-series still reflects the simulation's true cadence\nvia each row's ``global_time`` field.\n\n``max_len`` optionally bounds ``history`` to the most recent N\nrecorded rows (a ring buffer): once the cap is reached each new\nrecord drops the oldest. Default ``None`` = unbounded (the\nhistorical behaviour \u2014 consumers such as v2ecoli that read the\nfull ``history`` are unaffected unless they opt in). ``max_len``\ncounts *recorded* rows (i.e. post-``subsample``).", "_contract": {"summary": "type(object) -> the object's type", "description": "type(name, bases, dict, **kwds) -> a new type", "inputs": {}, "outputs": {}, "config": {}, "math": [], "symbols": {}, "assumptions": [], "references": [], "face": {"inputs": {}, "outputs": {}}, "amendments": []}, "_inputs": {"nodes": "map[dynamic_node]", "edges": "map[dynamic_edge]", "time": "float"}, "_outputs": {"results": "node"}}, "_declared_emit_paths": ["sync/sync_std", "metrics/n_nodes", "metrics/n_edges", "nodes", "edges", "global_time"]}, "schema": {}, "overrides": {}, "requires": {}, "tags": [], "visualizations": [], "analyses": [], "emitters": [{"address": "local:ParquetEmitter", "paths": ["sync/sync_std", "metrics/n_nodes", "metrics/n_edges"]}], "kind": "generator", "module": "viva_dynamic_networks.composites.family_c", "default_n_steps": null, "preferred_time": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}