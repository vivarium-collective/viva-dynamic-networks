{"id": "viva_dynamic_networks.composites.family_c.growing_repressilator_network", "name": "growing_repressilator_network", "description": "Dynamics on a GROWING topology: forest-fire growth adds Repressilator reactor-nodes over time while protein diffusion couples them \u2014 newcomers join at their own phase and entrain. (Forest-fire growth gives the dense local coupling that lets the growing network synchronise at a numerically stable D.)", "parameters": {"D": {"type": "float", "default": 0.25, "description": "inter-node diffusion coefficient"}, "max_nodes": {"type": "float", "default": 11.0, "description": "final network size"}, "grow_every": {"type": "float", "default": 10.0, "description": "model-time units between node additions"}, "seed": {"type": "float", "default": 1.0, "description": "phase/RNG seed"}}, "state": {"growth": {"_type": "process", "address": "local:NetworkDynamicsProcess", "config": {"rule": "forest_fire", "rule_params": {"p_forward": 0.5, "max_links": 8.0, "max_nodes": 11.0}, "seed": 1}, "interval": 10.0, "inputs": {"nodes": ["nodes"], "edges": ["edges"]}, "outputs": {"nodes": ["nodes"], "edges": ["edges"]}, "doc": "Apply one dynamic-network reaction per step to a bigraph-stored graph.", "interval_label": "10 s", "_contract": {"summary": "type(object) -> the object's type", "description": "type(name, bases, dict, **kwds) -> a new type", "inputs": {}, "outputs": {}, "config": {}, "math": [], "symbols": {}, "assumptions": [], "references": [], "face": {"inputs": {}, "outputs": {}}, "amendments": []}, "_inputs": {"nodes": "map[dynamic_node]", "edges": "map[dynamic_edge]"}, "_outputs": {"nodes": "map[dynamic_node]", "edges": "map[dynamic_edge]"}}, "nodes": {"0": {"fitness": 1.0, "birth": 0.0, "group": "0", "activity": 0.0, "state": 0.0, "species": {"PX": 75.17658986931372, "PY": 815.3537584070451, "PZ": 452.08005388170415, "X": 0.5875898383505891, "Y": 17.006262615537047, "Z": 0.5042607506636632}}, "1": {"fitness": 1.0, "birth": 0.0, "group": "0"