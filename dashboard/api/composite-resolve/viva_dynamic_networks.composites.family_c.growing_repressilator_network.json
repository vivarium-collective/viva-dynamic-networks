ferences": [], "face": {"inputs": {}, "outputs": {}}, "amendments": []}, "_inputs": {"nodes": "map[dynamic_node]", "edges": "map[dynamic_edge]", "time": "float"}, "_outputs": {"results": "node"}}, "_declared_emit_paths": ["sync/sync_std", "metrics/n_nodes", "metrics/n_edges", "nodes", "edges", "global_time"]}, "schema": {}, "overrides": {}, "requires": {}, "tags": [], "visualizations": [], "analyses": [], "emitters": [{"address": "local:ParquetEmitter", "paths": ["sync/sync_std", "metrics/n_nodes", "metrics/n_edges"]}], "kind": "generator", "module": "viva_dynamic_networks.composites.family_c", "default_n_steps": null, "preferred_time": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}