ctivity_driven.gif"}], "embed_visualizations": [{"name": "Interactive network animation", "url": "/viva-dynamic-networks/workbench/workspace/studies/08-activity-driven-temporal/viz/activity_driven.html"}], "expected_behavior": [{"name": "ad-conserves-nodes", "observable": "n_nodes", "condition": "node count is constant (no growth)", "rationale": "Activity-driven dynamics act on a fixed population."}, {"name": "ad-sparse-snapshots", "observable": "n_edges", "condition": "each instantaneous snapshot is sparse (edges reset each step)", "rationale": "Edges last a single window, so the per-step graph is far below the fully-grown density."}], "behavior_tests": [{"name": "adn-node-count-conserved", "classification": "invariant", "description": "Node count is constant at 44.", "measure": {"kind": "flat", "observable": "n_nodes", "reduce": "last"}, "pass_if": {"op": "equals", "value": 44, "tolerance": 0}, "units": "nodes", "requires_simulation": "yes", "cites": ["perra2012activity"]}, {"name": "adn-sparse-snapshot", "classification": "quantitative", "description": "Instantaneous snapshots stay sparse (mean degree < 2).", "measure": {"kind": "flat", "observable": "mean_degree", "reduce": "last"}, "pass_if": {"op": "at_most", "value": 2.0}, "units": "edges", "requires_simulation": "yes", "cites": ["perra2012activity", "holme2012temporal"]}], "bibliography": {"bib_keys": ["perra2012activity", "holme2012temporal"]}, "findings": [{"name": "activity_driven-signature", "summary": "Activity-driven firing produces a sparse, blinking temporal network \u2014 each snapshot is instantaneous, unlike the accreting Family-A graphs.", "detail": "Each snapshot is a sparse, blinking contact graph rather than an accreting structure \u2014 the temporal-network view that complements the growth and rewire families.", "_lifecycle_floor": "provisional-claim"}], "report": {"verdict": "Activity-driven firing produces a sparse, blinking temporal network \u2014 each snapshot is instantaneous, unlike the